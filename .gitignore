# ---- 大文件：走网盘同步，不进 git ----
data/raw/*
data/processed/*
index/*
models/*
outputs/*
!**/.gitkeep

# 标注结果要进 git（体积小且重要）
!data/eval/*.csv
!data/eval/*.xls
!data/eval/*.xlsx
!data/eval/*.md

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 编辑器 ----
.vscode/
.idea/

# ---- 密钥，绝对不要提交 ----
.env
*.key
secrets.json
